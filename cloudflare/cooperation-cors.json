{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://temparchivo.vercel.app",
          "https://v0-lunas-moradas.vercel.app",
          "https://pizarracursado.vercel.app",
          "https://cursado.vercel.app",
          "http://localhost:3000"
        ],
        "methods": ["PUT", "GET", "HEAD", "DELETE"],
        "headers": ["Content-Type", "x-amz-*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
